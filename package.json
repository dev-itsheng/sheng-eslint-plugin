{
  "name": "@sheng/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules distilled from shengsheng.fun frontend guardrail articles.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "AGENT_PROMPT.md",
    "FILES.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run && pnpm run docs:check",
    "docs:check": "tsx scripts/check-docs.ts",
    "files:index": "tsx scripts/generate-files-index.ts",
    "sync:blog": "tsx scripts/sync-blog-kits.ts",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "vue",
    "nuxt",
    "guardrails"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "scule": "1.3.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.0 || ^9.0.0 || ^10.0.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "vue-eslint-parser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vue/compiler-sfc": "^3.5.40",
    "eslint": "^10.7.0",
    "tsx": "^4.22.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  }
}
